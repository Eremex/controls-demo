<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
            xunit v3 on the Microsoft Testing Platform: "dotnet test" then launches this project's
            own executable, so Program.Main can own the process main thread. macOS (AppKit) will
            not create windows on any other thread. These have to sit in the project body, before
            the SDK targets pick a test runner.
        -->
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

        <Nullable>disable</Nullable>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <RootNamespace>Eremex.Avalonia.Controls.UITests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
      <AvaloniaXaml Remove="App.axaml" />
    </ItemGroup>
    <ItemGroup>
      <Compile Remove="App.axaml.cs" />
    </ItemGroup>
    <ItemGroup>
		<PackageReference Include="Eremex.Avalonia.Controls" />
		<PackageReference Include="Eremex.Avalonia.Themes.DeltaDesign" />

		<PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Headless" />

        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\..\DemoCenter\DemoCenter\DemoCenter.csproj" />
    </ItemGroup>

</Project>
