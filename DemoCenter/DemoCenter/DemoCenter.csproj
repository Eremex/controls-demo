    <Compile Remove="Views\Graphics3DControl\**" />
    <Compile Remove="ProductsData\Graphics3DControlGroupInfo.cs" />
    <AvaloniaXaml Remove="Views\Graphics3DControl\**" />
    <AvaloniaXaml Remove="Resources\Graphics3DStyles.axaml" />
