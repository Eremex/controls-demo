<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mxc="https://schemas.eremexcontrols.net/avalonia/charts"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:vm="clr-namespace:DemoCenter.ViewModels"
             x:Class="DemoCenter.Views.CartesianCandlestickAggregationView"
             x:DataType="vm:CartesianCandlestickAggregationViewModel"
             x:CompileBindings="True">
    <Grid ColumnDefinitions="* 250">
        <mxc:CartesianChart Grid.Column="0" Classes="DemoChart" x:Name="DemoControl">
            <mxc:CartesianSeries DataAdapter="{Binding StockData}" SeriesName="Price">
                <mxc:CartesianCandlestickSeriesView Color="#00787A" ReductionColor="#BD1436" />
            </mxc:CartesianSeries>

            <mxc:CartesianChart.AxesX>
                <mxc:AxisX ShowTitle="False">
                    <mxc:AxisX.ScaleOptions>
                        <mxc:DateTimeScaleOptions MeasureUnit="{Binding MeasureUnit}" MeasureUnitFactor="{Binding MeasureUnitFactor}" />
                    </mxc:AxisX.ScaleOptions>
                </mxc:AxisX>
            </mxc:CartesianChart.AxesX>
            
            <mxc:CartesianChart.AxesY>
                <mxc:AxisY Title="Price" Position="Far">
                    <mxc:AxisYRange AlwaysShowZeroLevel="False" />
                </mxc:AxisY>
            </mxc:CartesianChart.AxesY>
            
            <mxc:CartesianChart.CrosshairOptions>
                <mxc:CrosshairOptions SeriesLabelMode="OneForAllSeries" />
            </mxc:CartesianChart.CrosshairOptions>
        </mxc:CartesianChart>
        
        <mxe:GroupBox Grid.Column="1" Header="Properties" Classes="PropertiesGroup Last" Margin="{DynamicResource OptionsMargin}">
            <StackPanel>
                <RadioButton Content="15 Minutes" Command="{Binding SetMeasureUnitCommand}" CommandParameter="{vm:DateTimeUnitItem Unit=Minute, Factor=15}" Classes="PropertyEditor"/>
                
                <RadioButton Content="30 Minutes" Command="{Binding SetMeasureUnitCommand}" CommandParameter="{vm:DateTimeUnitItem Unit=Minute, Factor=30}" Classes="PropertyEditor"/>
                    
                <RadioButton Content="1 Hour" Command="{Binding SetMeasureUnitCommand}" CommandParameter="{vm:DateTimeUnitItem Unit=Hour, Factor=1}" IsChecked="True" Classes="PropertyEditor"/>
                    
                <RadioButton Content="5 Hours" Command="{Binding SetMeasureUnitCommand}" CommandParameter="{vm:DateTimeUnitItem Unit=Hour, Factor=5}" Classes="PropertyEditor"/>
                    
                <RadioButton Content="1 Day" Command="{Binding SetMeasureUnitCommand}" CommandParameter="{vm:DateTimeUnitItem Unit=Day, Factor=1}" Classes="PropertyEditor"/>
            </StackPanel>
        </mxe:GroupBox>
    </Grid>
</UserControl>
