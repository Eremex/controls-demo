<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mx="https://schemas.eremexcontrols.net/avalonia"
             xmlns:mxc="clr-namespace:Eremex.AvaloniaUI.Charts;assembly=Eremex.Avalonia.Charts"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:vm="using:DemoCenter.ViewModels"
             x:Class="DemoCenter.Views.CartesianLollipopSeriesViewView"
             x:DataType="vm:CartesianLollipopSeriesViewViewModel"
             x:CompileBindings="True">
    <Grid ColumnDefinitions="* 250">
        <mxc:CartesianChart Grid.Column="0" Classes="DemoChart" x:Name="DemoControl">
            <mxc:CartesianSeries DataAdapter="{Binding DataAdapter}">
                <mxc:CartesianLollipopSeriesView Color="#BD1436"
                                                 LineColor="#00787A"
                                                 MarkerSize="{Binding MarkerSize}"
                                                 LineOrientation="{Binding LineOrientation}"
                                                 MarkerImageCss=".base_color{{fill:{0};}}">
                    <SvgImage Source="avares://DemoCenter/Resources/Svg/Ring.svg" />
                    <mxc:CartesianLollipopSeriesView.LineStyle>
                        <mxc:LineStyle Thickness="{Binding LineThickness}" />
                    </mxc:CartesianLollipopSeriesView.LineStyle>
                </mxc:CartesianLollipopSeriesView>
            </mxc:CartesianSeries>
            <mxc:CartesianChart.AxesY>
                <mxc:AxisY ShowTitle="False" />
            </mxc:CartesianChart.AxesY>
            <mxc:CartesianChart.AxesX>
                <mxc:AxisX ShowTitle="False" />
            </mxc:CartesianChart.AxesX>
        </mxc:CartesianChart>
        
        <StackPanel Grid.Column="1" Margin="{DynamicResource OptionsMargin}">
            <mxe:GroupBox Header="Cartesian Chart" Classes="PropertiesGroup">
                <mxe:CheckEditor Content="Swap Axes" IsChecked="{Binding ElementName=DemoControl, Path=SwapAxes}" Classes="PropertyEditor"/>
            </mxe:GroupBox>
            <mxe:GroupBox Header="Properties" Classes="PropertiesGroup Last">
                <StackPanel>
                    <Label Content="Line Thickness" Classes="PropertyEditor EditorLabel" />
                    <Slider Minimum="1" Maximum="8" Value="{Binding LineThickness}" IsSnapToTickEnabled="True" TickFrequency="1" />
                    
                    <Label Content="Marker Size" Classes="PropertyEditor EditorLabel" />
                    <Slider Minimum="10" Maximum="20" Value="{Binding MarkerSize}" IsSnapToTickEnabled="True" TickFrequency="1" />
                    
                    <Label Content="Line Orientation" Classes="PropertyEditor EditorLabel" />
                    <mxe:ComboBoxEditor EditorValue="{Binding LineOrientation}" ItemsSource="{mx:EnumItemsSource EnumType=mxc:CartesianLollipopOrientation}" Classes="PropertyEditor"/>
                </StackPanel>
            </mxe:GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
