<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:mxc="https://schemas.eremexcontrols.net/avalonia/charts"
             xmlns:vm="clr-namespace:DemoCenter.ViewModels"
             x:Class="DemoCenter.Views.CartesianLineSeriesViewView"
             x:DataType="vm:CartesianLineSeriesViewViewModel">
    <Grid ColumnDefinitions="* 250">
        <mxc:CartesianChart Grid.Column="0" Classes="DemoChart" SeriesSource="{Binding Series}" x:Name="DemoControl">
            <mxc:CartesianChart.SeriesTemplate>
                <DataTemplate x:DataType="vm:SeriesViewModel">
                    <mxc:CartesianSeries DataAdapter="{Binding DataAdapter}">
                        <mxc:CartesianLineSeriesView Color="{Binding Color}"
                                                     ShowMarkers="{Binding ElementName=CheShowMarkers, Path=IsChecked}"
                                                     MarkerSize="{Binding ElementName=SlMarkerSize, Path=Value}">
                            <mxc:CartesianLineSeriesView.LineStyle>
                                <mxc:LineStyle Thickness="{Binding ElementName=SlLineThickness, Path=Value}" />
                            </mxc:CartesianLineSeriesView.LineStyle>
                        </mxc:CartesianLineSeriesView>
                    </mxc:CartesianSeries>
                </DataTemplate>
            </mxc:CartesianChart.SeriesTemplate>

            <mxc:CartesianChart.AxesX>
                <mxc:AxisX ShowTitle="False" />
            </mxc:CartesianChart.AxesX>
            <mxc:CartesianChart.AxesY>
                <mxc:AxisY ShowTitle="False" />
            </mxc:CartesianChart.AxesY>
        </mxc:CartesianChart>
        
        <StackPanel Grid.Column="1" Margin="{DynamicResource OptionsMargin}">
            <mxe:GroupBox Header="Cartesian Chart" Classes="PropertiesGroup">
                <mxe:CheckEditor Content="Swap Axes" IsChecked="{Binding ElementName=DemoControl, Path=SwapAxes}" Classes="PropertyEditor"/>
            </mxe:GroupBox>
            <mxe:GroupBox Header="Properties" Classes="PropertiesGroup Last">
                <StackPanel>
                    <Label Content="Line Thickness" Classes="PropertyEditor EditorLabel" />
                    <Slider x:Name="SlLineThickness" Minimum="1" Maximum="8" Value="2" />
                    
                    <mxe:CheckEditor x:Name="CheShowMarkers" Content="Show Markers" IsChecked="True" Classes="PropertyEditor" />
                    
                    <Label Content="Marker Size" Classes="PropertyEditor EditorLabel" />
                    <Slider x:Name="SlMarkerSize" Minimum="4" Maximum="20" Value="8" IsEnabled="{Binding ElementName=CheShowMarkers, Path=IsChecked}" />
                </StackPanel>
            </mxe:GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
