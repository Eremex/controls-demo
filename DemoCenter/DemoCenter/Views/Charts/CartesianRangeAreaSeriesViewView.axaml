<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:mxc="https://schemas.eremexcontrols.net/avalonia/charts"
             xmlns:vm="clr-namespace:DemoCenter.ViewModels"
             x:Class="DemoCenter.Views.CartesianRangeAreaSeriesViewView"
             x:DataType="vm:CartesianRangeAreaSeriesViewViewModel"
>
    <Grid ColumnDefinitions="* 250">
        <mxc:CartesianChart Grid.Column="0" Classes="DemoChart" x:Name="DemoControl">
            <mxc:CartesianSeries DataAdapter="{Binding DataAdapter}">
                <mxc:CartesianRangeAreaSeriesView Color="{Binding Color}"
                                                  Color1="{Binding Color1}"
                                                  Color2="{Binding Color2}"
                                                  Transparency="{Binding ElementName=SlTransparency, Path=Value}"
                                                  ShowMarkers1="{Binding ElementName=CheShowMarkers1, Path=IsChecked}"
                                                  ShowMarkers2="{Binding ElementName=CheShowMarkers2, Path=IsChecked}"
                                                  Marker1Size="{Binding ElementName=SlMarkerSize1, Path=Value}"
                                                  Marker2Size="{Binding ElementName=SlMarkerSize2, Path=Value}">
                    <mxc:CartesianRangeAreaSeriesView.LineStyle1>
                        <mxc:LineStyle Thickness="{Binding ElementName=SlLineThickness1, Path=Value}" />
                    </mxc:CartesianRangeAreaSeriesView.LineStyle1>
                    <mxc:CartesianRangeAreaSeriesView.LineStyle2>
                        <mxc:LineStyle Thickness="{Binding ElementName=SlLineThickness2, Path=Value}" />
                    </mxc:CartesianRangeAreaSeriesView.LineStyle2>
                </mxc:CartesianRangeAreaSeriesView>
            </mxc:CartesianSeries>

            <mxc:CartesianChart.AxesX>
                <mxc:AxisX ShowTitle="False" />
            </mxc:CartesianChart.AxesX>
            <mxc:CartesianChart.AxesY>
                <mxc:AxisY ShowTitle="False" />
            </mxc:CartesianChart.AxesY>
        </mxc:CartesianChart>

        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="{DynamicResource OptionsMargin}">
                <mxe:GroupBox Header="Cartesian Chart" Classes="PropertiesGroup">
                    <mxe:CheckEditor Content="Swap Axes" IsChecked="{Binding ElementName=DemoControl, Path=SwapAxes}" Classes="PropertyEditor"/>
                </mxe:GroupBox>
                <mxe:GroupBox Header="Properties" Classes="PropertiesGroup Last">
                    <StackPanel>
                        <Label Content="Transparency" Classes="PropertyEditor EditorLabel" />
                        <Slider x:Name="SlTransparency" Minimum="0" Maximum="1" Value="0.3"/>

                        <Label Content="Line 1 Thickness" Classes="PropertyEditor EditorLabel" />
                        <Slider x:Name="SlLineThickness1" Minimum="1" Maximum="8" Value="2"/>

                        <mxe:CheckEditor x:Name="CheShowMarkers1" Content="Show Markers" IsChecked="True" Classes="PropertyEditor" />

                        <Label Content="Marker 1 Size" Classes="PropertyEditor EditorLabel" />
                        <Slider x:Name="SlMarkerSize1" Minimum="4" Maximum="20" Value="8" IsEnabled="{Binding ElementName=CheShowMarkers1, Path=IsChecked}" />

                        <Label Content="Line 2 Thickness" Classes="PropertyEditor EditorLabel" />
                        <Slider x:Name="SlLineThickness2" Minimum="1" Maximum="8" Value="2"/>

                        <mxe:CheckEditor x:Name="CheShowMarkers2" Content="Show Markers" IsChecked="True" Classes="PropertyEditor" />

                        <Label Content="Marker 1 Size" Classes="PropertyEditor EditorLabel" />
                        <Slider x:Name="SlMarkerSize2" Minimum="4" Maximum="20" Value="8" IsEnabled="{Binding ElementName=CheShowMarkers2, Path=IsChecked}" />
                    </StackPanel>
                </mxe:GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
