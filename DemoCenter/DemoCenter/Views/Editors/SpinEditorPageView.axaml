<UserControl x:Class="DemoCenter.Views.SpinEditorPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:mxdg="https://schemas.eremexcontrols.net/avalonia/datagrid"
             xmlns:mxi="https://schemas.eremexcontrols.net/avalonia/icons"
             xmlns:vm="using:DemoCenter.ViewModels"
             d:DesignHeight="500"
             d:DesignWidth="800"
             x:DataType="vm:SpinEditorPageViewModel"
             mc:Ignorable="d">
	<Design.DataContext>
        <vm:SpinEditorPageViewModel />
	</Design.DataContext>

    <Grid ColumnDefinitions="*, 250">
        <ContentControl x:Name="DemoControl" Classes="DemoUserControl">
            <Grid  RowDefinitions="Auto, 60, Auto"
              HorizontalAlignment="Center"
              Margin="30">
                <Grid ColumnDefinitions="Auto, 26, Auto" HorizontalAlignment="Center">
                    <mxe:SpinEditor x:Name="SpinEditor" Width="200" Value="7"
                                Maximum="{Binding #MaximumValueEditor.Value}"
                                Minimum="{Binding #MinimumValueEditor.Value}"
                                Increment="{Binding #IncrementValueEditor.Value}"
                                IsEnabled="{Binding #IsEnabledSelector.IsChecked}"
                                ShowEditorButtons="{Binding #ShowButtonsSelector.IsChecked}"
                                AllowRoundOutOfRangeValue="{Binding #AllowRoundOutOfRangeSelector.IsChecked}"                                      
                                Mask="{Binding #MaskEditor.EditorValue}"/>

                    <mxe:SpinEditor Grid.Column="2" x:Name="PrefixSuffixSpinEditor" Width="200" Value="8.5"
                            Maximum="{Binding #MaximumValueEditor.Value}"
                            Minimum="{Binding #MinimumValueEditor.Value}"
                            Increment="{Binding #IncrementValueEditor.Value}"
                            Prefix="V=" Suffix="m/s"
                            IsEnabled="{Binding #IsEnabledSelector.IsChecked}"
                            ShowEditorButtons="{Binding #ShowButtonsSelector.IsChecked}"
                            AllowRoundOutOfRangeValue="{Binding #AllowRoundOutOfRangeSelector.IsChecked}"
                            Mask="{Binding #MaskEditor.EditorValue}"/>
                </Grid>
            
            <mxdg:DataGridControl x:Name="materialsGrid"
                                  Grid.Row="2"
                                  Width="540"
                                  ShowGroupPanel="False"
                                  AllowSorting="False"
                                  BorderThickness="1"
                                  EditorButtonShowMode="ShowAlways"
                                  ItemsSource="{Binding Yachts}">
                <mxdg:GridColumn FieldName="Name" Width="*" AllowEditing="False" />
                <mxdg:GridColumn FieldName="Length" Header="Length, ft" Width="*">
                    <mxdg:GridColumn.EditorProperties>
                        <mxe:SpinEditorProperties HorizontalContentAlignment="Right"/>
                    </mxdg:GridColumn.EditorProperties>
                </mxdg:GridColumn>
                <mxdg:GridColumn FieldName="MaxSpeed" Width="*" >
                    <mxdg:GridColumn.EditorProperties>
                        <mxe:SpinEditorProperties DisplayFormatString="{}{0:N1}" Suffix="knots" HorizontalContentAlignment="Right" Increment="0.5"/>
                    </mxdg:GridColumn.EditorProperties>
                </mxdg:GridColumn>
                <mxdg:GridColumn FieldName="CruisingRange" Width="*" >
                    <mxdg:GridColumn.EditorProperties>
                        <mxe:SpinEditorProperties Increment="100" Suffix="miles" HorizontalContentAlignment="Right"/>
                    </mxdg:GridColumn.EditorProperties>
                </mxdg:GridColumn>
            </mxdg:DataGridControl>
        </Grid>
        </ContentControl>

        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="{DynamicResource OptionsMargin}">
                <mxe:GroupBox Header="Properties" Classes="PropertiesGroup">
                    <StackPanel>
                        <mxe:CheckEditor x:Name="IsEnabledSelector" Content="Is Enabled" IsChecked="True" Classes="PropertyEditor"/>

                        <mxe:CheckEditor x:Name="ShowButtonsSelector" Content="Show Buttons" IsChecked="True" Classes="PropertyEditor"/>

                        <mxe:CheckEditor x:Name="AllowRoundOutOfRangeSelector" Content="Round Out Of Range" Classes="PropertyEditor"/>

                        <Label Content="Value" Classes="PropertyEditor EditorLabel"/>
                        <mxe:TextEditor EditorValue="{Binding #SpinEditor.Value}" Classes="PropertyEditor" HorizontalContentAlignment="Right"/>

                        <Label Content="Maximum" Classes="PropertyEditor EditorLabel"/>
                        <mxe:SpinEditor x:Name="MaximumValueEditor" Value="15" Classes="PropertyEditor"/>

                        <Label Content="Minimum" Classes="PropertyEditor EditorLabel" />
                        <mxe:SpinEditor x:Name="MinimumValueEditor" Value="-15" Classes="PropertyEditor"/>

                        <Label Content="Increment" Classes="PropertyEditor EditorLabel"/>
                        <mxe:SpinEditor x:Name="IncrementValueEditor" Value="1" Classes="PropertyEditor"/>

                        <Label Content="Mask" Classes="PropertyEditor EditorLabel"/>
                        <mxe:TextEditor x:Name="MaskEditor" EditorValue="##.##" Classes="PropertyEditor" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </mxe:GroupBox>
                <mxe:GroupBox Header="Commands" Classes="PropertiesGroup Last">
                    <Grid ColumnDefinitions="*, Auto, *">
                        <Button Command="{Binding #SpinEditor.DecreaseCommand}" ToolTip.Tip="Decrease" Classes="PropertyEditor">
                            <Image Source="{x:Static mxi:_12.Chevron_Left}" Width="16" Height="16"/>
                        </Button>

                        <Border Grid.Column="1" Margin="{DynamicResource PropertyEditorPadding}"/>

                        <Button Grid.Column="2" Command="{Binding #SpinEditor.IncreaseCommand}" ToolTip.Tip="Increase" Classes="PropertyEditor">
                            <Image Source="{x:Static mxi:_12.Chevron_Right}" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </mxe:GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
