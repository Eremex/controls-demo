<UserControl x:Class="DemoCenter.Views.ApplicationServices.DialogServicePageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:demo="clr-namespace:DemoCenter.Views.ApplicationServices"
             xmlns:vm="using:DemoCenter.ViewModels.ApplicationServices"
             d:DesignHeight="600"
             d:DesignWidth="900"
             x:CompileBindings="True"
             x:DataType="vm:DialogServicePageViewModel"
             mc:Ignorable="d">

    <Grid ColumnDefinitions="*, 320">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <demo:DemoPageHeader
                    Title="IDialogService"
                    Summary="Modal dialogs described by a view model. The view model supplies the title, the content and the buttons; the service creates the window, attaches the view model and returns the result." />

                <mxe:GroupBox Header="Dialog content" Classes="PropertiesGroup">
                    <StackPanel Margin="12" Spacing="8">
                        <TextBlock Text="Title" />
                        <mxe:TextEditor EditorValue="{Binding DialogTitle, Mode=TwoWay}" />
                        <TextBlock Text="Message" />
                        <mxe:TextEditor EditorValue="{Binding DialogMessage, Mode=TwoWay}" />
                    </StackPanel>
                </mxe:GroupBox>

                <demo:DemoScenario
                    Title="Ok / Cancel"
                    Description="OkCancelDialogAwareViewModel already provides both buttons, so the view model adds nothing."
                    ActionCaption="Show dialog"
                    Command="{Binding ShowOkCancelCommand}" />

                <demo:DemoScenario
                    Title="Custom button set"
                    Description="Overriding CreateButtons replaces the standard set — here Apply takes the place of Ok."
                    ActionCaption="Show Apply / Cancel"
                    Command="{Binding ShowApplyCancelCommand}" />

                <demo:DemoScenario
                    Title="Captions and placement"
                    Description="Buttons carry their own captions and can be docked to either side of the footer."
                    ActionCaption="Show Yes / No"
                    Command="{Binding ShowYesNoCommand}" />

                <demo:DemoScenario
                    Title="Validation"
                    Description="CanOk keeps the default button disabled until the input is valid. The dialog content comes from a view picked by ViewLocatorAttribute."
                    ActionCaption="Show validated dialog"
                    Command="{Binding ShowValidationCommand}" />

                <demo:DemoScenario
                    Title="Nested modal"
                    Description="A dialog opened from another dialog. The nested window blocks its parent, not the whole application."
                    ActionCaption="Show nested dialog"
                    Command="{Binding ShowNestedCommand}" />

            </StackPanel>
        </ScrollViewer>

        <demo:DemoResultLog Grid.Column="1"
                            ItemsSource="{Binding Log}"
                            ClearCommand="{Binding ClearLogCommand}" />
    </Grid>
</UserControl>
