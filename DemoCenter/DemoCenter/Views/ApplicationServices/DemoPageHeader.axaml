<UserControl x:Class="DemoCenter.Views.ApplicationServices.DemoPageHeader"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             x:CompileBindings="False">

    <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Summary, ElementName=Root}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Text/Neutral/Secondary}" />
    </StackPanel>
</UserControl>
