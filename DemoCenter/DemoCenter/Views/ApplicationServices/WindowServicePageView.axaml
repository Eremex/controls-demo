<UserControl x:Class="DemoCenter.Views.ApplicationServices.WindowServicePageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:demo="clr-namespace:DemoCenter.Views.ApplicationServices"
             xmlns:vm="using:DemoCenter.ViewModels.ApplicationServices"
             d:DesignHeight="600"
             d:DesignWidth="900"
             x:CompileBindings="True"
             x:DataType="vm:WindowServicePageViewModel"
             mc:Ignorable="d">

    <Grid ColumnDefinitions="*, 320">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <demo:DemoPageHeader
                    Title="IWindowService and IWindowsManager"
                    Summary="Non-modal windows described by a view model, and the window manager that tells every other service which window is currently active." />

                <mxe:GroupBox Header="Window" Classes="PropertiesGroup">
                    <StackPanel Margin="12" Spacing="8">
                        <TextBlock Text="Title" />
                        <mxe:TextEditor EditorValue="{Binding WindowTitle, Mode=TwoWay}" />
                    </StackPanel>
                </mxe:GroupBox>

                <demo:DemoScenario
                    Title="Non-modal window"
                    Description="The window opens and this page stays usable. Its content comes from a view picked by ViewLocatorAttribute."
                    ActionCaption="Show window"
                    Command="{Binding ShowWindowCommand}" />

                <demo:DemoScenario
                    Title="Caption from the service"
                    Description="A caption passed to Show wins over the title on the view model."
                    ActionCaption="Show with caption"
                    Command="{Binding ShowWindowWithCaptionCommand}" />

                <demo:DemoScenario
                    Title="Owner chain"
                    Description="Opens two windows. A modal dialog started from one of them blocks that window only — the other stays usable."
                    ActionCaption="Show two windows"
                    Command="{Binding ShowTwoWindowsCommand}" />

                <demo:DemoScenario
                    Title="Active window"
                    Description="IWindowsManager tracks the active window. Every service falls back to it when no owner is passed in."
                    ActionCaption="Report active window"
                    Command="{Binding ReportActiveWindowCommand}" />

            </StackPanel>
        </ScrollViewer>

        <demo:DemoResultLog Grid.Column="1"
                            ItemsSource="{Binding Log}"
                            ClearCommand="{Binding ClearLogCommand}" />
    </Grid>
</UserControl>
